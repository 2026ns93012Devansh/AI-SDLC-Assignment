{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reminder Agent Output",
  "type": "object",
  "required": [
    "title",
    "date",
    "time",
    "priority",
    "status",
    "needs_clarification"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "time": {
      "type": ["string", "null"],
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "priority": {
      "type": ["string", "null"],
      "enum": ["Low", "Medium", "High", null]
    },
    "status": {
      "type": "string",
      "enum": ["ready", "needs_clarification"]
    },
    "needs_clarification": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "ready"}
        }
      },
      "then": {
        "properties": {
          "needs_clarification": {"const": false},
          "title": {"type": "string"},
          "date": {"type": "string"},
          "time": {"type": "string"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "needs_clarification"}
        }
      },
      "then": {
        "properties": {
          "needs_clarification": {"const": true}
        }
      }
    }
  ]
}